const http = require('http');
const mineflayer = require('mineflayer');
const fs = require('fs');

// 1. Keep Render Free Tier alive with a health-check HTTP server
http.createServer((req, res) => {
  res.writeHead(200, { 'Content-Type': 'text/plain' });
  res.write("Bot is running!");
  res.end();
}).listen(process.env.PORT || 3000);

// 2. Load settings.json
let settings = {};
try {
  const rawData = fs.readFileSync('./settings.json');
  settings = JSON.parse(rawData);
} catch (e) {
  console.log("Error reading settings.json: " + e.message);
}

// 3. Function to start the Minecraft bot
function createBot() {
  const serverConfig = settings.server || {
    host: "Aarav1hgc.aternos.me",
    port: 25565,
    username: "PerzaanAFK",
    version: false
  };

  console.log(`Attempting to connect to ${serverConfig.host}:${serverConfig.port} as ${serverConfig.username}...`);

  const bot = mineflayer.createBot({
    host: serverConfig.host,
    port: serverConfig.port || 25565,
    username: serverConfig.username || "PerzaanAFK",
    version: serverConfig.version || false
  });

  bot.on('spawn', () => {
    console.log("Bot has successfully spawned into the server!");
  });

  bot.on('error', (err) => {
    console.log("Bot error: ", err);
  });

  bot.on('end', () => {
    console.log("Bot disconnected. Reconnecting in 5 seconds...");
    setTimeout(() => {
      createBot();
    }, 5000);
  });
}

// ===================================================
// CRASH RECOVERY
// ===================================================
process.on('uncaughtException', (err) => {
  console.log(`[FATAL] Uncaught Exception: ${err.message}`);
});

process.on('unhandledRejection', (reason) => {
  console.log(`[FATAL] Unhandled Rejection: ${reason}`);
});

// ===================================================
// START THE BOT
// ===================================================
console.log('='.repeat(50));
console.log('  Minecraft AFK Bot v2 - Running on Render  ');
console.log('='.repeat(50));

createBot();
